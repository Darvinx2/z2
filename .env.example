# Параметры подключения к PostgreSQL (см. docker-compose.yml)
DATABASE_URL=postgresql+psycopg://filemanager:filemanager@localhost:5433/filemanager

# Каталог-песочница, внутри которого разрешены все файловые операции
STORAGE_ROOT=./storage

# Ограничения при распаковке ZIP-архивов (защита от zip-бомб)
MAX_UNPACKED_SIZE=104857600
MAX_ARCHIVE_ENTRIES=1000
